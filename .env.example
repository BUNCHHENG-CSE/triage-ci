# ========================================================
# TCT TriageCI Environment Configuration (Example)
# ========================================================

# 1. Database Configuration
# Local SQLite (Default, Zero-Config):
DATABASE_URL="file:./triageci.db"

# Production Neon PostgreSQL:
# DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Environment & Security
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="TCT TriageCI"
ENVIRONMENT=development
GITHUB_WEBHOOK_SECRET=triageci_webhook_secret_dev

# 3. Optional LLM Providers (Offline Deterministic Heuristic Engine operates if left blank)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
