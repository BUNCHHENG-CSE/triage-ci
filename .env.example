# ========================================================
# TriageCI Environment Configuration Template
# ========================================================

# Database (PostgreSQL via WSL Docker or Production Cloud SQL / RDS)
DATABASE_URL="postgresql://triageci:triageci_secure_pass@127.0.0.1:5434/triageci?schema=public"
POSTGRES_USER=triageci
POSTGRES_PASSWORD=triageci_secure_pass
POSTGRES_DB=triageci
POSTGRES_PORT=5434

# Connection Pool Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Environment & Webhooks
ENVIRONMENT=production
GITHUB_WEBHOOK_SECRET=triageci_webhook_secret_prod

# Optional LLM Providers (Heuristic Expert Engine operates if left blank)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
