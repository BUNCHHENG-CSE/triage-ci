    "prisma:studio": "node node_modules/prisma/build/index.js studio --port 5555",
    "prisma:test": "node scripts/test_prisma.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  }
