// ========================================================
// TriageCI Prisma ORM Schema - Local SQLite
// ========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Recurring failure clusters aggregated by deterministic error signature
model FailureCluster {
  id                  Int          @id @default(autoincrement())
  fingerprint         String       @unique(map: "ix_failure_clusters_fingerprint")
  title               String
  category            String
  suggestedActionType String       @map("suggested_action_type") // "RERUN" or "FIX"
  suggestedDirection  String       @map("suggested_direction")
  occurrenceCount     Int          @default(1) @map("occurrence_count")
  firstSeen           DateTime     @default(now()) @map("first_seen")
  lastSeen            DateTime     @default(now()) @updatedAt @map("last_seen")
  status              String       @default("ACTIVE") // "ACTIVE", "RESOLVED", "IGNORED"
  affectedRepos       String       @default("[]") @map("affected_repos") // JSON array string
  
  // 1-to-many relation with failure logs
  logs                FailureLog[]

  // Indexes for high-performance dashboard querying
  @@index([status, occurrenceCount(sort: Desc)], map: "idx_clusters_status_occ")
  @@index([category, occurrenceCount(sort: Desc)], map: "idx_clusters_cat_occ")
  @@index([category], map: "ix_failure_clusters_category")
  @@map("failure_clusters")
}

/// Individual pipeline failure log ingestion & root-cause attribution
model FailureLog {
  id                   Int             @id @default(autoincrement())
  provider             String          @default("github_actions")
  repoName             String          @default("unknown-org/repo") @map("repo_name")
  branch               String          @default("main")
  commitSha            String          @default("HEAD") @map("commit_sha")
  commitAuthor         String          @default("engineer") @map("commit_author")
  prNumber             Int?            @map("pr_number")
  workflowName         String          @default("CI Pipeline") @map("workflow_name")
  jobName              String          @default("test") @map("job_name")

  // Triage Diagnostic Outputs
  exactFailingStep     String          @map("exact_failing_step")
  rootCauseCategory    String          @map("root_cause_category")
  rootCauseSummary     String          @map("root_cause_summary")
  actionType           String          @map("action_type") // "RERUN" or "FIX"
  suggestedDirection   String          @map("suggested_direction")
  confidenceScore      Float           @default(0.9) @map("confidence_score")
  fingerprint          String

  // Extracted Evidence Excerpt
  extractedExcerpt     String          @map("extracted_excerpt")
  excerptStartLine     Int             @default(1) @map("excerpt_start_line")
  excerptEndLine       Int             @default(1) @map("excerpt_end_line")
  totalRawLines        Int             @default(0) @map("total_raw_lines")
  rawLog               String?         @map("raw_log")
  prCommentMarkdown    String?         @map("pr_comment_markdown")

  // One-Click Remediation Playbook
  remediationCommands  String?         @default("[]") @map("remediation_commands") // JSON array string
  remediationPatch     String?         @map("remediation_patch")

  // Foreign key relation to recurring cluster
  clusterId            Int?            @map("cluster_id")
  cluster              FailureCluster? @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  createdAt            DateTime        @default(now()) @map("created_at")

  // Indexes for filtering & sorting
  @@index([clusterId, createdAt(sort: Desc)], map: "idx_logs_cluster_created")
  @@index([repoName, createdAt(sort: Desc)], map: "idx_logs_repo_created")
  @@index([rootCauseCategory, createdAt(sort: Desc)], map: "idx_logs_cat_created")
  @@index([actionType, createdAt(sort: Desc)], map: "idx_logs_action_created")
  @@index([fingerprint, createdAt(sort: Desc)], map: "idx_logs_fingerprint_created")
  @@index([createdAt], map: "ix_failure_logs_created_at")
  @@map("failure_logs")
}
